# Dependencies
node_modules/
**/node_modules/

# Environment variables & secrets
.env
.env.*
!.env.example
**/.env
**/.env.*
!**/.env.example
backend/*.json
!backend/package.json
!backend/package-lock.json

# Build output
dist/
dist-ssr/
**/dist/

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# System & OS Files
.DS_Store
**/.DS_Store
Thumbs.db

