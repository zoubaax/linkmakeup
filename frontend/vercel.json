{
  "rewrites": [
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(facebookexternalhit|WhatsApp|Twitterbot|TelegramBot|LinkedInBot|Slackbot|Discordbot|Applebot).*"
        }
      ],
      "destination": "https://api.linkmakeup.com/api/v1/profiles/check-og"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
