import { NavLink, useLocation, useNavigate } from 'react-router-dom';
import { useAuth } from '../../contexts/AuthContext';
import ThemeToggle from '../ThemeToggle';
import Logo from '../ui/Logo';
import ToastContainer from '../ui/ToastContainer';
import { ADMIN_NAV } from './adminNav';

const SECTION_TITLES = {
  '/admin': 'Overview',
  '/admin/users': 'Users',
  '/admin/profiles': 'Profiles',
  '/admin/links': 'Links',
};

function getSectionTitle(pathname) {
  if (SECTION_TITLES[pathname]) return SECTION_TITLES[pathname];
  if (pathname.startsWith('/admin')) return 'Platform Admin';
  return 'Platform Admin';
}

function sidebarLinkClassName({ isActive }) {
  return [
    'flex items-center gap-3 rounded-xl border px-3.5 py-3 text-sm font-semibold transition-all',
    isActive
      ? 'border-accent-border bg-accent-subtle text-fg shadow-2xs'
      : 'border-transparent text-fg-muted hover:text-fg hover:bg-surface-alt/80',
  ].join(' ');
}

function mobileTabClassName({ isActive }) {
  return [
    'inline-flex items-center gap-2 shrink-0 rounded-full border px-3.5 py-1.5 text-xs font-semibold transition-all',
    isActive
      ? 'border-accent-border bg-accent-subtle text-fg'
      : 'border-border bg-surface text-fg-muted hover:text-fg',
  ].join(' ');
}

export default function AdminShell({ children }) {
  const { pathname } = useLocation();
  const navigate = useNavigate();
  const { user, logout } = useAuth();

  const handleSignOut = async () => {
    await logout();
    window.location.href = '/';
  };

  return (
    <div className="min-h-screen bg-app text-fg font-sans flex">
      <aside className="hidden lg:flex lg:flex-col w-64 shrink-0 sticky top-0 h-screen border-r border-border bg-surface">
        <div className="p-4 border-b border-border/80">
          <NavLink to="/admin" className="inline-flex items-center gap-2.5 py-0.5">
            <Logo height={32} />
          </NavLink>
          <p className="mt-2 text-[11px] font-semibold uppercase tracking-wider text-fg-subtle">
            Platform Admin
          </p>
        </div>

        <nav className="flex-1 p-3 space-y-1 overflow-y-auto">
          {ADMIN_NAV.map((item) => (
            <NavLink
              key={item.to}
              to={item.to}
              end={item.end}
              className={sidebarLinkClassName}
            >
              {item.icon}
              <div className="min-w-0">
                <p className="truncate">{item.label}</p>
                <p className="text-[11px] font-normal text-fg-subtle truncate">{item.description}</p>
              </div>
            </NavLink>
          ))}
        </nav>

        <div className="p-3 border-t border-border space-y-2">
          <button
            type="button"
            onClick={() => navigate('/dashboard')}
            className="w-full flex items-center gap-2.5 rounded-xl px-3.5 py-2.5 text-sm font-semibold text-fg-muted hover:text-fg hover:bg-surface-alt transition-colors"
          >
            <svg className="w-4 h-4 shrink-0" fill="none" stroke="currentColor" strokeWidth="2" viewBox="0 0 24 24">
              <path strokeLinecap="round" strokeLinejoin="round" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
            </svg>
            Back to Studio
          </button>
          <button
            type="button"
            onClick={handleSignOut}
            className="w-full rounded-xl border border-border px-3.5 py-2.5 text-sm font-medium text-fg-muted hover:text-fg hover:bg-surface-alt transition-colors text-left"
          >
            Sign Out
          </button>
        </div>
      </aside>

      <div className="flex-1 flex flex-col min-w-0">
        <header className="sticky top-0 z-30 border-b border-border/80 bg-surface/95 backdrop-blur-md">
          <div className="flex items-center justify-between gap-3 px-4 sm:px-6 h-13">
            <div className="flex items-center gap-3 min-w-0 lg:hidden">
              <Logo height={28} />
            </div>
            <div className="hidden lg:block min-w-0">
              <p className="text-sm font-bold text-fg truncate">{getSectionTitle(pathname)}</p>
            </div>
            <div className="flex items-center gap-2 shrink-0">
              <span className="hidden sm:inline-flex items-center gap-1.5 rounded-full border border-accent-border bg-accent-subtle px-2.5 py-0.5 text-[10px] font-semibold uppercase tracking-wide text-accent">
                <span className="h-1.5 w-1.5 rounded-full bg-accent" />
                Admin
              </span>
              <ThemeToggle />
              {user?.avatarUrl ? (
                <img
                  src={user.avatarUrl}
                  alt=""
                  className="w-7 h-7 rounded-full object-cover border border-border shrink-0"
                  referrerPolicy="no-referrer"
                />
              ) : (
                <div className="w-7 h-7 rounded-full bg-surface-muted border border-border flex items-center justify-center text-xs font-bold text-fg shrink-0">
                  {user?.name?.[0] || 'A'}
                </div>
              )}
            </div>
          </div>

          <nav className="lg:hidden px-4 pb-3 overflow-x-auto">
            <div className="flex items-center gap-2 min-w-max">
              {ADMIN_NAV.map((item) => (
                <NavLink
                  key={item.to}
                  to={item.to}
                  end={item.end}
                  className={mobileTabClassName}
                >
                  {item.icon}
                  {item.label}
                </NavLink>
              ))}
            </div>
          </nav>
        </header>

        <main className="flex-1 min-h-0 animate-page-in">{children}</main>
      </div>

      <ToastContainer />
    </div>
  );
}
